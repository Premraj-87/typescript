{
  "compilerOptions": {
   
    "rootDir": "./src",
    "outDir": "./dist",

    
    "module": "commonjs",
    "target": "esnext",
    "types": [],


    
    "sourceMap": true,
    "declaration": true,
    

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
